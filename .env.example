# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais versionné.

# Clé de l'API Claude (console.anthropic.com). Facultative si `ant auth login` a été fait.
ANTHROPIC_API_KEY=

# Modèle utilisé par l'agent.
CLAUDE_MODEL=claude-opus-5-5

# Machine à diagnostiquer : ursim | fake (roarm et motorscope arrivent en phase 2).
CONNECTOR=ursim

# Adresse du contrôleur (URSim lancé en local avec Docker).
ROBOT_HOST=127.0.0.1

# Nom du conteneur Docker d'URSim (lecture du journal et injection de pannes).
URSIM_CONTAINER=ursim

# Budget de tokens réservé aux enregistrements envoyés au LLM.
RECORDING_TOKEN_BUDGET=40000

# Niveau des journaux affichés dans le terminal (le fichier data/robot_agentic.log reçoit tout).
LOG_LEVEL=WARNING

# Code PIN demandé avant le premier mouvement d'une enquête (vide : pas de code).
OPERATOR_PIN=
