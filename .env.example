# Copy this file to .env and fill in the values. The .env file is never versioned.
# Each variable overrides the default of the setting of the same name in src/robot_agentic/config.py.

# Claude API key (console.anthropic.com). Optional if `ant auth login` was done.
ANTHROPIC_API_KEY=

# Model used by the agent.
CLAUDE_MODEL=claude-opus-5-5

# Machine to diagnose: ursim | fake
CONNECTOR=ursim

# Controller address (URSim started locally with Docker).
ROBOT_HOST=127.0.0.1

# Name of the URSim Docker container (log reading and fault injection).
URSIM_CONTAINER=ursim

# Token budget of one table of values sent to the LLM.
RECORDING_TOKEN_BUDGET=40000

# Level of the logs shown in the terminal (data/robot_agentic.log receives everything).
LOG_LEVEL=WARNING

# PIN code asked before the first movement of an investigation (empty: no code).
OPERATOR_PIN=
